# =========================
# App
# =========================
NODE_ENV=development
APP_NAME=AdCoDe
APP_URL=http://localhost:4173
API_PORT=4100
WEB_PORT=4173
APP_VERSION=dev
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4173

# =========================
# Database
# =========================
# Local: usar contenedor PostgreSQL existente en red-desarrollo (postgres-local)
# Si la app corre dentro de docker-compose local (misma red), host postgres-local puerto 5432.
# Si corres la app fuera de Docker contra el puerto expuesto en host, usa localhost:5433.
DATABASE_URL=postgresql://postgres:postgres@postgres-local:5432/adcode?schema=public

# Producción: PostgreSQL ya existente (postgres-principal u otro). Configurar solo DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/adcode?schema=public

# =========================
# Auth / Sessions
# =========================
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/v1/auth/google/callback
PLATFORM_ADMIN_EMAIL=admin@supernovatel.com
PLATFORM_ADMIN_NAME=Platform Admin
DEV_LOGIN_ENABLED=true

# =========================
# S3 / MinIO (opcional en desarrollo local)
# =========================
# En local no se levanta MinIO por compose; dejar vacío para deshabilitar uploads o apuntar a un S3 disponible.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=adcode
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# Producción: MinIO/S3 ya existente (ej. https://s3.supernovatel.com). Usar access key dedicada.
# S3_ENDPOINT=http://192.168.10.57:9000
# S3_PUBLIC_ENDPOINT=https://s3.supernovatel.com
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# =========================
# Business defaults
# =========================
RESERVATION_HOLD_MINUTES=15
DEFAULT_TIMEZONE=America/La_Paz
DEFAULT_CURRENCY=BOB
DEFAULT_LOCALE=es-BO
DEFAULT_NIGHT_START=18:00
MODULE_EXPIRY_WARN_DAYS=7

# =========================
# Push / Email (optional)
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@supernovatel.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_SERVERNAME=

# =========================
# Deploy
# =========================
DOCKER_EXTERNAL_NETWORK=red-interna
RUN_SEED_ON_DEPLOY=0

# =========================
# Frontend runtime (env.js)
# =========================
PUBLIC_API_BASE_URL=/api/v1
PUBLIC_APP_NAME=AdCoDe
PUBLIC_VAPID_PUBLIC_KEY=
