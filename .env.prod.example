# =========================
# App (PRODUCCIÓN)
# =========================
NODE_ENV=production
APP_NAME=AdCoDe
APP_URL=https://adcode.supernovatel.com
API_PORT=4100
WEB_PORT=80
APP_VERSION=latest
LOG_LEVEL=info
CORS_ORIGINS=https://adcode.supernovatel.com

# =========================
# Database (PostgreSQL existente)
# =========================
DATABASE_URL=postgresql://user:password@postgres-principal:5432/adcode?schema=public

# =========================
# Auth / Sessions
# =========================
JWT_ACCESS_SECRET=change-me-access-secret-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-prod
REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=supernovatel.com
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://adcode.supernovatel.com/api/v1/auth/google/callback
PLATFORM_ADMIN_EMAIL=admin@supernovatel.com
PLATFORM_ADMIN_NAME=Platform Admin
DEV_LOGIN_ENABLED=false

# =========================
# S3 / MinIO (producción)
# =========================
S3_ENDPOINT=http://192.168.10.57:9000
S3_PUBLIC_ENDPOINT=https://s3.supernovatel.com
S3_REGION=us-east-1
S3_BUCKET=adcode
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# =========================
# Business defaults
# =========================
RESERVATION_HOLD_MINUTES=15
DEFAULT_TIMEZONE=America/La_Paz
DEFAULT_CURRENCY=BOB
DEFAULT_LOCALE=es-BO
DEFAULT_NIGHT_START=18:00
MODULE_EXPIRY_WARN_DAYS=7

# =========================
# Push / Email
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@supernovatel.com
SMTP_HOST=mail.supernovatel.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_SERVERNAME=ferozo.com

# =========================
# Deploy
# =========================
DOCKER_EXTERNAL_NETWORK=red-interna
RUN_SEED_ON_DEPLOY=0

# =========================
# Frontend runtime (env.js)
# =========================
PUBLIC_API_BASE_URL=/api/v1
PUBLIC_APP_NAME=AdCoDe
PUBLIC_VAPID_PUBLIC_KEY=
