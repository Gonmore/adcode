generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  COMPLEX_ADMIN
  SELLER
  CLIENT
}

enum ClientTierType {
  NORMAL
  HABITUAL
  PREFERENCIAL
}

enum AppModule {
  AUTH
  USERS
  SCENARIOS
  SALES
  INVENTORY
  REPORTS
}

enum ReservationStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  EXPIRED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  TRANSFER
  QR
  SHARED_QR
  CREDIT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum RentalFormat {
  PER_HOUR
  PER_PERSON
  MIXED
  FLAT_BLOCK
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum FinancialSource {
  RESERVATION
  SALE
  SUPPLIER_PAYMENT
  MAINTENANCE
  OTHER
}

enum StockMovementType {
  IN
  OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
  WASTE
}

enum MaintenanceType {
  ONE_TIME
  WEEKLY
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  avatarUrl     String?
  googleSub     String?       @unique
  isActive      Boolean       @default(true)
  memberships   Membership[]
  refreshSessions RefreshSession[]
  messages      Message[]     @relation("MessageSender")
  auditLogs     AuditLog[]    @relation("AuditActor")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Tenant {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  status        String        @default("ACTIVE")
  maxComplexes  Int           @default(1)
  contactName   String
  contactEmail  String
  contactPhone  String?
  complexes     Complex[]
  memberships   Membership[]
  subscriptions ModuleSubscription[]
  clientTiers   ClientTier[]
  auditLogs     AuditLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Membership {
  id          String      @id @default(cuid())
  userId      String
  tenantId    String
  role        Role
  complexIds  String[]    @default([])
  clientTier  ClientTierType @default(NORMAL)
  debtLimit   Decimal?    @db.Decimal(12, 2)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, tenantId, role])
  @@index([tenantId, role])
}

model Complex {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  timezone    String        @default("America/La_Paz")
  currency    String        @default("BOB")
  nightStart  String        @default("18:00")
  nightEnd    String        @default("06:00")
  logoKey     String?
  isActive    Boolean       @default(true)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentSettings PaymentSettings?
  scenarios   Scenario[]
  scenarioGroups ScenarioGroup[]
  reservations Reservation[]
  kiosks      Kiosk[]
  warehouses  Warehouse[]
  orders      Order[]
  transactions FinancialTransaction[]
  maintenances Maintenance[]
  subscriptions ModuleSubscription[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ModuleSubscription {
  id          String    @id @default(cuid())
  tenantId    String
  complexId   String?
  module      AppModule
  startsAt    DateTime
  endsAt      DateTime
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complex     Complex?  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, module, endsAt])
}

model RefreshSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

model PaymentSettings {
  id            String   @id @default(cuid())
  complexId     String   @unique
  bankName      String?
  accountNumber String?
  accountHolder String?
  methods       PaymentMethod[] @default([CASH, TRANSFER, QR])
  complex       Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  qrs           PaymentQr[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentQr {
  id                String   @id @default(cuid())
  paymentSettingsId String
  imageKey          String
  label             String?
  isActive          Boolean  @default(true)
  paymentSettings   PaymentSettings @relation(fields: [paymentSettingsId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

model ClientTier {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  type            ClientTierType
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  allowVipBooking Boolean  @default(false)
  creditLimit     Decimal? @db.Decimal(12, 2)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model ScenarioGroup {
  id        String    @id @default(cuid())
  complexId String
  name      String
  kind      String
  complex   Complex   @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenarios Scenario[]
  createdAt DateTime  @default(now())

  @@index([complexId])
}

model Scenario {
  id            String       @id @default(cuid())
  complexId     String
  groupId       String?
  name          String
  rentalFormat  RentalFormat @default(PER_HOUR)
  exclusive     Boolean      @default(true)
  capacity      Int?
  minDuration   Int?         // minutes
  stepMinutes   Int?         // minutes
  isActive      Boolean      @default(true)
  photos        String[]     @default([])
  complex       Complex      @relation(fields: [complexId], references: [id], onDelete: Cascade)
  group         ScenarioGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  pricingRules  PricingRule[]
  reservations  Reservation[]
  maintenances  Maintenance[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([complexId, isActive])
}

model PricingRule {
  id               String   @id @default(cuid())
  scenarioId       String
  period           String   // DAY | NIGHT
  dayOfWeek        Int?
  pricePerHour     Decimal? @db.Decimal(12, 2)
  pricePerPerson   Decimal? @db.Decimal(12, 2)
  basePrice        Decimal? @db.Decimal(12, 2)
  includedPeople   Int?
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, period])
}

model Reservation {
  id              String            @id @default(cuid())
  code            String            @unique
  complexId       String
  scenarioId      String
  membershipId    String?
  clientName      String?
  startAt         DateTime
  endAt           DateTime
  people          Int?
  status          ReservationStatus @default(PENDING_PAYMENT)
  holdExpiresAt   DateTime?
  isVip           Boolean           @default(false)
  priceSubtotal   Decimal           @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal           @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal           @db.Decimal(12, 2) @default(0)
  note            String?
  complex         Complex           @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenario        Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  membership      Membership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  conversation    Conversation?
  payments        Payment[]
  order           Order?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([complexId, startAt, endAt])
  @@index([scenarioId, startAt, endAt])
  @@index([status, holdExpiresAt])
}

model Maintenance {
  id          String          @id @default(cuid())
  complexId   String
  scenarioId  String?
  type        MaintenanceType @default(ONE_TIME)
  startAt     DateTime
  endAt       DateTime
  dayOfWeek   Int?
  reason      String?
  cost        Decimal?        @db.Decimal(12, 2)
  complex     Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenario    Scenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([complexId, startAt, endAt])
}

model Conversation {
  id            String      @id @default(cuid())
  reservationId String      @unique
  complexId     String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime    @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String?
  kind           String       @default("TEXT") // TEXT|SYSTEM|ATTACHMENT
  body           String?
  attachmentKey  String?
  mime           String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String?
  orderId       String?
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  receiptKey    String?
  confirmedById String?
  metadata      Json?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([reservationId, status])
}

model FinancialTransaction {
  id            String          @id @default(cuid())
  complexId     String
  scenarioId    String?
  scenarioGroup String?
  type          FinancialType
  source        FinancialSource
  amount        Decimal         @db.Decimal(12, 2)
  method        PaymentMethod?
  occurredAt    DateTime        @default(now())
  refType       String?
  refId         String?
  note          String?
  complex       Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@index([complexId, occurredAt])
  @@index([source, occurredAt])
}

model Kiosk {
  id          String   @id @default(cuid())
  complexId   String
  warehouseId String?
  name        String
  isActive    Boolean  @default(true)
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  orders      Order[]
  createdAt   DateTime @default(now())
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
}

model Product {
  id          String            @id @default(cuid())
  categoryId  String?
  name        String
  cost        Decimal           @db.Decimal(12, 2) @default(0)
  price       Decimal           @db.Decimal(12, 2) @default(0)
  active      Boolean           @default(true)
  imageKey    String?
  category    ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  presentations ProductPresentation[]
  stockLots   StockLot[]
  orderLines  OrderLine[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductPresentation {
  id           String  @id @default(cuid())
  productId    String
  name         String
  unitsPerPack Int     @default(1)
  barcode      String?
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  complexId     String
  kioskId       String?
  reservationId String?     @unique
  membershipId  String?
  status        String      @default("PENDING")
  total         Decimal     @db.Decimal(12, 2) @default(0)
  complex       Complex     @relation(fields: [complexId], references: [id], onDelete: Cascade)
  kiosk         Kiosk?      @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  membership    Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2) @default(0)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Warehouse {
  id         String              @id @default(cuid())
  complexId  String
  name       String
  complex    Complex             @relation(fields: [complexId], references: [id], onDelete: Cascade)
  locations  WarehouseLocation[]
  stockLots  StockLot[]
  kiosks     Kiosk[]
  movementsFrom StockMovement[] @relation("FromWarehouse")
  movementsTo   StockMovement[] @relation("ToWarehouse")
  createdAt  DateTime            @default(now())
}

model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  name        String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLots   StockLot[]
}

model StockLot {
  id          String             @id @default(cuid())
  productId   String
  warehouseId String
  locationId  String?
  qty         Int                @default(0)
  expiresAt   DateTime?
  unitCost    Decimal            @db.Decimal(12, 2) @default(0)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location    WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())

  @@index([productId, warehouseId, expiresAt])
}

model StockMovement {
  id              String            @id @default(cuid())
  type            StockMovementType
  productId       String
  qty             Int
  fromWarehouseId String?
  toWarehouseId   String?
  refType         String?
  refId           String?
  note            String?
  createdAt       DateTime          @default(now())
  fromWarehouse   Warehouse?        @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse     Warehouse?        @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
}

model Supplier {
  id      String       @id @default(cuid())
  name    String
  contact String?
  entries StockEntry[]
}

model StockEntry {
  id            String        @id @default(cuid())
  supplierId    String?
  warehouseId   String
  total         Decimal       @db.Decimal(12, 2) @default(0)
  paymentMethod PaymentMethod?
  receiptKey    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
}
