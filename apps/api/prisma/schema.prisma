generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  COMPLEX_ADMIN
  SELLER
  CLIENT
}

enum ClientTierType {
  NORMAL
  HABITUAL
  PREFERENCIAL
}

enum AppModule {
  AUTH
  USERS
  SCENARIOS
  SALES
  INVENTORY
  REPORTS
}

enum ReservationStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  EXPIRED
  CANCELLED
  REJECTED
  NO_SHOW
  SCHEDULED
}

enum ReservationSeriesStatus {
  ACTIVE
  IN_ARREARS
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QR
  SHARED_QR
  CREDIT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum RentalFormat {
  PER_HOUR
  PER_PERSON
  MIXED
  FLAT_BLOCK
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum FinancialSource {
  RESERVATION
  SALE
  SUPPLIER_PAYMENT
  MAINTENANCE
  OTHER
}

enum StockMovementType {
  IN
  OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
  WASTE
}

enum MaintenanceType {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  phone         String?
  lastDepartment String?
  avatarUrl     String?
  googleSub     String?       @unique
  passwordHash  String?
  isActive      Boolean       @default(true)
  memberships   Membership[]
  refreshSessions RefreshSession[]
  messages      Message[]     @relation("MessageSender")
  auditLogs     AuditLog[]    @relation("AuditActor")
  notifications Notification[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Tenant {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  status        String        @default("ACTIVE")
  maxComplexes  Int           @default(1)
  contactName   String
  contactEmail  String
  contactPhone  String?
  complexes     Complex[]
  memberships   Membership[]
  subscriptions ModuleSubscription[]
  clientTiers   ClientTier[]
  auditLogs     AuditLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Membership {
  id          String      @id @default(cuid())
  userId      String
  tenantId    String
  role        Role
  complexIds  String[]    @default([])
  clientTier  ClientTierType @default(NORMAL)
  debtLimit   Decimal?    @db.Decimal(12, 2)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orders      Order[]
  reservationSeries ReservationSeries[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, tenantId, role])
  @@index([tenantId, role])
}

model Complex {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  slug                String
  department          String        @default("Santa Cruz")
  timezone            String        @default("America/La_Paz")
  currency            String        @default("BOB")
  nightStart          String        @default("18:00")
  nightEnd            String        @default("06:00")
  openTime            String        @default("08:00")
  closeTime           String        @default("22:00")
  weekendOpenTime     String?
  weekendCloseTime    String?
  weeklySchedule      Json?
  allowClientPayLater Boolean       @default(false)
  logoKey             String?
  isActive            Boolean       @default(true)
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentSettings     PaymentSettings?
  scenarios           Scenario[]
  scenarioGroups      ScenarioGroup[]
  reservations        Reservation[]
  kiosks              Kiosk[]
  warehouses          Warehouse[]
  orders              Order[]
  transactions        FinancialTransaction[]
  maintenances        Maintenance[]
  subscriptions       ModuleSubscription[]
  notifications       Notification[]
  reservationSeries   ReservationSeries[]
  suppliers           Supplier[]
  productCategories   ProductCategory[]
  products            Product[]
  stockMovements      StockMovement[]
  stockEntries        StockEntry[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([department])
}

model ModuleSubscription {
  id          String    @id @default(cuid())
  tenantId    String
  complexId   String?
  module      AppModule
  startsAt    DateTime
  endsAt      DateTime
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complex     Complex?  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, module, endsAt])
}

model RefreshSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

model PaymentSettings {
  id            String   @id @default(cuid())
  complexId     String   @unique
  bankName      String?
  accountNumber String?
  accountHolder String?
  methods       PaymentMethod[] @default([CASH, TRANSFER, QR])
  complex       Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  qrs           PaymentQr[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentQr {
  id                String   @id @default(cuid())
  paymentSettingsId String
  imageKey          String
  label             String?
  isActive          Boolean  @default(true)
  paymentSettings   PaymentSettings @relation(fields: [paymentSettingsId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

model ClientTier {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  type            ClientTierType
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  allowVipBooking Boolean  @default(false)
  creditLimit     Decimal? @db.Decimal(12, 2)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model ScenarioGroup {
  id        String    @id @default(cuid())
  complexId String
  name      String
  kind      String
  complex   Complex   @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenarios Scenario[]
  createdAt DateTime  @default(now())

  @@index([complexId])
}

model Scenario {
  id            String       @id @default(cuid())
  complexId     String
  groupId       String?
  name          String
  rentalFormat  RentalFormat @default(PER_HOUR)
  exclusive     Boolean      @default(true)
  capacity      Int?
  minDuration   Int?         // minutes
  stepMinutes   Int?         // minutes
  isActive      Boolean      @default(true)
  openTime      String?
  closeTime     String?
  availableDays Int[]        @default([0,1,2,3,4,5,6])
  photos        String[]     @default([])
  complex       Complex      @relation(fields: [complexId], references: [id], onDelete: Cascade)
  group         ScenarioGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  pricingRules  PricingRule[]
  reservations  Reservation[]
  maintenances  Maintenance[]
  reservationSeries  ReservationSeries[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([complexId, isActive])
}

model PricingRule {
  id               String   @id @default(cuid())
  scenarioId       String
  period           String   // DAY | NIGHT
  dayOfWeek        Int?
  pricePerHour     Decimal? @db.Decimal(12, 2)
  pricePerPerson   Decimal? @db.Decimal(12, 2)
  childPrice       Decimal? @db.Decimal(12, 2)
  childAgeThreshold Int?    @default(10)
  basePrice        Decimal? @db.Decimal(12, 2)
  blockType        String?
  includedPeople   Int?
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, period])
}


model ReservationSeries {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  complexId            String
  scenarioId           String
  membershipId         String?
  clientName           String?
  weekday              Int
  startMinutes         Int
  endMinutes           Int
  status               ReservationSeriesStatus @default(ACTIVE)
  debtCount            Int                    @default(0)
  currentReservationId String?                @unique
  note                 String?
  complex              Complex                @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenario             Scenario               @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  membership           Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  currentReservation   Reservation?           @relation("SeriesCurrent", fields: [currentReservationId], references: [id], onDelete: SetNull)
  reservations         Reservation[]          @relation("SeriesReservations")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([complexId, status])
  @@index([scenarioId, status])
}

model Reservation {
  id              String            @id @default(cuid())
  code            String            @unique
  seriesId        String?
  reservationSeriesId String?
  seriesDueAt         DateTime?
  seriesPaidAt        DateTime?
  isSeriesCurrent     Boolean           @default(false)
  complexId       String
  scenarioId      String
  membershipId    String?
  clientName      String?
  startAt         DateTime
  endAt           DateTime
  people          Int?
  status          ReservationStatus @default(PENDING_PAYMENT)
  holdExpiresAt   DateTime?
  isVip           Boolean           @default(false)
  priceSubtotal   Decimal           @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal           @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal           @db.Decimal(12, 2) @default(0)
  note            String?
  complex         Complex           @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenario        Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  membership      Membership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  series              ReservationSeries? @relation("SeriesReservations", fields: [reservationSeriesId], references: [id], onDelete: SetNull)
  currentForSeries    ReservationSeries? @relation("SeriesCurrent")
  conversation    Conversation?
  payments        Payment[]
  order           Order?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([complexId, startAt, endAt])
  @@index([scenarioId, startAt, endAt])
  @@index([status, holdExpiresAt])
  @@index([seriesId])
  @@index([reservationSeriesId, startAt])
}

model Maintenance {
  id          String          @id @default(cuid())
  complexId   String
  scenarioId  String?
  type        MaintenanceType @default(ONE_TIME)
  startAt     DateTime
  endAt       DateTime
  dayOfWeek   Int?
  reason      String?
  cost        Decimal?        @db.Decimal(12, 2)
  complex     Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  scenario    Scenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([complexId, startAt, endAt])
}

model Conversation {
  id            String      @id @default(cuid())
  reservationId String      @unique
  complexId     String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime    @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String?
  kind           String       @default("TEXT") // TEXT|SYSTEM|ATTACHMENT
  body           String?
  attachmentKey  String?
  mime           String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String?
  orderId       String?
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  receiptKey    String?
  confirmedById String?
  metadata      Json?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([reservationId, status])
}

model FinancialTransaction {
  id            String          @id @default(cuid())
  complexId     String
  scenarioId    String?
  scenarioGroup String?
  type          FinancialType
  source        FinancialSource
  amount        Decimal         @db.Decimal(12, 2)
  method        PaymentMethod?
  occurredAt    DateTime        @default(now())
  refType       String?
  refId         String?
  note          String?
  complex       Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@index([complexId, occurredAt])
  @@index([source, occurredAt])
}

model Kiosk {
  id          String   @id @default(cuid())
  complexId   String
  warehouseId String?
  name        String
  isActive    Boolean  @default(true)
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  orders      Order[]
  createdAt   DateTime @default(now())
}

model ProductCategory {
  id        String    @id @default(cuid())
  complexId String?
  name      String
  complex   Complex?  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([complexId])
}

model Product {
  id            String                @id @default(cuid())
  complexId     String?
  categoryId    String?
  supplierId    String?
  name          String
  notes         String?
  cost          Decimal               @db.Decimal(12, 2) @default(0)
  price         Decimal               @db.Decimal(12, 2) @default(0)
  active        Boolean               @default(true)
  imageKey      String?
  complex       Complex?              @relation(fields: [complexId], references: [id], onDelete: Cascade)
  category      ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  presentations ProductPresentation[]
  stockLots     StockLot[]
  orderLines    OrderLine[]
  movements     StockMovement[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([complexId, active])
}

model ProductPresentation {
  id           String          @id @default(cuid())
  productId    String
  name         String
  unitsPerPack Int             @default(1)
  barcode      String?
  cost         Decimal         @db.Decimal(12, 2) @default(0)
  price        Decimal         @db.Decimal(12, 2) @default(0)
  active       Boolean         @default(true)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLots    StockLot[]
  orderLines   OrderLine[]
  movements    StockMovement[]

  @@index([productId, active])
}

model Order {
  id            String      @id @default(cuid())
  complexId     String
  kioskId       String?
  reservationId String?     @unique
  membershipId  String?
  status        String      @default("PENDING")
  total         Decimal     @db.Decimal(12, 2) @default(0)
  complex       Complex     @relation(fields: [complexId], references: [id], onDelete: Cascade)
  kiosk         Kiosk?      @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  membership    Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderLine {
  id             String               @id @default(cuid())
  orderId        String
  productId      String
  presentationId String?
  qty            Int
  unitPrice      Decimal              @db.Decimal(12, 2)
  unitCost       Decimal              @db.Decimal(12, 2) @default(0)
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
}

model Warehouse {
  id         String              @id @default(cuid())
  complexId  String
  name       String
  complex    Complex             @relation(fields: [complexId], references: [id], onDelete: Cascade)
  locations  WarehouseLocation[]
  stockLots  StockLot[]
  kiosks     Kiosk[]
  movementsFrom StockMovement[] @relation("FromWarehouse")
  movementsTo   StockMovement[] @relation("ToWarehouse")
  stockEntries StockEntry[]
  createdAt  DateTime            @default(now())
}

model WarehouseLocation {
  id           String          @id @default(cuid())
  warehouseId  String
  name         String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLots    StockLot[]
  stockEntries StockEntry[]
  movements    StockMovement[]
}

model StockLot {
  id             String               @id @default(cuid())
  productId      String
  presentationId String?
  warehouseId    String
  locationId     String?
  qty            Int                  @default(0)
  expiresAt      DateTime?
  unitCost       Decimal              @db.Decimal(12, 2) @default(0)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location       WarehouseLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([productId, warehouseId, expiresAt])
  @@index([presentationId, warehouseId, locationId])
}

model StockMovement {
  id              String               @id @default(cuid())
  complexId       String?
  type            StockMovementType
  productId       String
  presentationId  String?
  locationId      String?
  qty             Int
  unitCost        Decimal?             @db.Decimal(12, 2)
  unitPrice       Decimal?             @db.Decimal(12, 2)
  fromWarehouseId String?
  toWarehouseId   String?
  refType         String?
  refId           String?
  note            String?
  createdAt       DateTime             @default(now())
  complex         Complex?             @relation(fields: [complexId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  presentation    ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  location        WarehouseLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  fromWarehouse   Warehouse?           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse     Warehouse?           @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@index([complexId, createdAt])
  @@index([productId, createdAt])
}

model Supplier {
  id        String       @id @default(cuid())
  complexId String?
  name      String
  contact   String?
  email     String?
  complex   Complex?     @relation(fields: [complexId], references: [id], onDelete: SetNull)
  entries   StockEntry[]
  products  Product[]
  createdAt DateTime     @default(now())

  @@index([complexId])
}

model StockEntry {
  id            String        @id @default(cuid())
  complexId     String?
  supplierId    String?
  warehouseId   String
  locationId    String?
  total         Decimal       @db.Decimal(12, 2) @default(0)
  paymentMethod PaymentMethod?
  receiptKey    String?
  notes         String?
  complex       Complex?      @relation(fields: [complexId], references: [id], onDelete: Cascade)
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location      WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([complexId, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  complexId   String?
  type        String
  title       String
  body        String
  data        Json?
  scheduledAt DateTime?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  complex     Complex? @relation(fields: [complexId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, scheduledAt])
  @@index([complexId, createdAt])
}


